{
  "expo": {
    "name": "Music Theory",
    "slug": "music-theory-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "musictheory",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.musictheory.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone to detect notes played on your guitar for the Listen mode in the Fretboard game."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D0D0B"
      },
      "package": "com.musictheory.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "436cc317-2e9e-4909-a27c-bf6785c724f2"
      },
      "router": {}
    },
    "owner": "rickysan"
  }
}
